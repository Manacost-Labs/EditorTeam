# Provider credentials are read by Docker Compose and never committed. They are not needed when
# EditorTeam is deployed inside the work stack with EDITOR_PROVIDER=agui.
EDITOR_API_KEY=replace-with-provider-key
EDITOR_PROVIDER=openrouter
EDITOR_MODEL=anthropic/claude-sonnet-4.5
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Internal work-stack route. Set these instead of EDITOR_API_KEY for the ChatGPT-authenticated path.
EDITOR_AGUI_URL=
EDITOR_AGUI_TOKEN=
EDITOR_REASONING_EFFORT=xhigh

# Optional defense-in-depth for the private AG-UI endpoint. If set, pass the same value
# as the Authorization key when registering the agent in work.kolodahearthstone.com.
EDITOR_AGENT_TOKEN=

# The host bridge is reachable from the OpenBot container as host.docker.internal.
EDITOR_BIND_ADDRESS=172.17.0.1
EDITOR_PORT=8740
EDITOR_MAX_ATTEMPTS=3
EDITOR_TIMEOUT_SEC=120
EDITOR_MAX_TEXT_BYTES=524288
EDITOR_PROMPT_VARIANT=candidate

# Optional Russian NLP and editorial toolchain
NATASHA_URL=http://127.0.0.1:8742
HUNSPELL_BIN=hunspell
RU_DICT_PATH=/usr/share/hunspell/ru_RU.dic
MARKDOWNLINT_BIN=markdownlint-cli2
MARKDOWNLINT_CONFIG=config/markdownlint/.markdownlint.json
LANGUAGETOOL_URL=http://127.0.0.1:8010
VALE_BIN=vale
VALE_CONFIG=/app/.vale.ini
PROMPTFOO_CONFIG=evals/promptfooconfig.yaml
EDITOR_GATEWAY_URL=http://127.0.0.1:8740
EDITOR_EVAL_PROVIDER=openai
EDITOR_EVAL_BASELINE_MODEL=replace-with-baseline-model
EDITOR_EVAL_CANDIDATE_MODEL=replace-with-candidate-model
EDITOR_EVAL_BASELINE_GATEWAY_URL=http://127.0.0.1:8740
EDITOR_EVAL_CANDIDATE_GATEWAY_URL=http://127.0.0.1:8741
EDITOR_EVAL_OFFLINE=0
# Optional: OpenAI-compatible endpoint and key only for the eval run; per-variant
# overrides EDITOR_EVAL_BASELINE_* / EDITOR_EVAL_CANDIDATE_* win over these.
EDITOR_EVAL_BASE_URL=
EDITOR_EVAL_API_KEY=
# CLI agent as the model: run `python tools/cli_model_bridge.py --backend codex --port 8790`,
# then EDITOR_PROVIDER=openai EDITOR_API_KEY=cli EDITOR_MODEL=codex and
# EDITOR_BASE_URL=http://host.docker.internal:8790/v1/chat/completions (see docs/evals.md).
# Judge model for evals/promptfooconfig.judge.yaml, e.g. openai:gpt-4o-mini.
EDITOR_EVAL_JUDGE_PROVIDER=
EDITOR_ALLOW_UNAVAILABLE=false
