# Provider credentials are read by Docker Compose and never committed. They are not needed when
# EditorTeam is deployed inside the work stack with EDITOR_PROVIDER=agui.
EDITOR_API_KEY=replace-with-provider-key
EDITOR_PROVIDER=openrouter
EDITOR_MODEL=anthropic/claude-sonnet-4.5

# Internal work-stack route. Set these instead of EDITOR_API_KEY for the ChatGPT-authenticated path.
EDITOR_AGUI_URL=
EDITOR_AGUI_TOKEN=
EDITOR_REASONING_EFFORT=xhigh

# Optional defense-in-depth for the private AG-UI endpoint. If set, pass the same value
# as the Authorization key when registering the agent in work.kolodahearthstone.com.
EDITOR_AGENT_TOKEN=

# The host bridge is reachable from the OpenBot container as host.docker.internal.
EDITOR_BIND_ADDRESS=172.17.0.1
EDITOR_PORT=8740
EDITOR_MAX_ATTEMPTS=3
EDITOR_TIMEOUT_SEC=120
EDITOR_MAX_TEXT_BYTES=524288
